{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-foundry-vault.local/schemas/trace.schema.json",
  "title": "Agent Foundry Vault Execution Trace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "task_id",
    "started_at",
    "finished_at",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "trace_id": {
      "type": "string",
      "minLength": 3
    },
    "task_id": {
      "type": "string",
      "minLength": 3
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["seq", "at", "phase", "role", "type", "status", "message"],
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 1
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "phase": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": ["system", "router", "worker", "writer", "reviewer"]
          },
          "type": {
            "enum": ["validation", "routing", "node-start", "node-result", "gate", "error"]
          },
          "status": {
            "enum": ["started", "completed", "blocked", "failed"]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
