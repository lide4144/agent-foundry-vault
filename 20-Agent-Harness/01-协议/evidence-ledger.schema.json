{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-foundry-vault.local/schemas/evidence-ledger.schema.json",
  "title": "Agent Foundry Vault Evidence Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trace_id", "task_id", "items"],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "trace_id": {
      "type": "string",
      "minLength": 3
    },
    "task_id": {
      "type": "string",
      "minLength": 3
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "claim",
          "source",
          "retrieved_at",
          "confidence",
          "verification_status",
          "adopted",
          "reason"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["uri", "source_type"],
            "properties": {
              "uri": {
                "type": "string",
                "minLength": 1
              },
              "source_type": {
                "enum": ["primary", "secondary", "user-provided", "mock"]
              },
              "title": {
                "type": "string"
              }
            }
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "verification_status": {
            "enum": ["unverified", "single-source", "corroborated", "conflicted"]
          },
          "adopted": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "conflict_set": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            },
            "default": []
          }
        }
      }
    }
  }
}
